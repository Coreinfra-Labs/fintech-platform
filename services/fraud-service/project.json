{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "fraud-service",
  "sourceRoot": "services/fraud-service/src",
  "projectType": "application",
  "tags": ["type:service", "scope:backend"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node src/index.js",
        "cwd": "services/fraud-service"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nodemon src/index.js",
        "cwd": "services/fraud-service"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo \"No build step required for Node.js service\""
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "eslint src --ext .js,.ts",
        "cwd": "services/fraud-service"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "jest --forceExit",
        "cwd": "services/fraud-service"
      }
    },
    "test-ci": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "jest --forceExit --ci --coverage",
        "cwd": "services/fraud-service"
      }
    }
  }
}
