
{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "payment-service",
  "sourceRoot": "services/payment-service/src",
  "projectType": "application",
  "tags": [
    "type:service",
    "scope:backend"
  ],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node src/index.js",
        "cwd": "services/payment-service"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nodemon src/index.js",
        "cwd": "services/payment-service"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "echo \"No compilation required for payment-service\"",
        "cwd": "services/payment-service"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "eslint src --ext .js,.ts",
        "cwd": "services/payment-service"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "jest --rootDir . --forceExit",
        "cwd": "services/payment-service"
      }
    },
    "test-ci": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "jest --rootDir . --forceExit --ci --coverage",
        "cwd": "services/payment-service"
      }
    }
  }
}
