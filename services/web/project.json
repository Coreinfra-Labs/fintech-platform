{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "services/web",
        "env": {
          "DISABLE_ESLINT_PLUGIN": "true"
        }
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "command": "pnpm exec vite preview --outDir build --host 0.0.0.0 --port 4200 --strictPort",
        "cwd": "services/web"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint services/web/src"
      }
    }
  }
}